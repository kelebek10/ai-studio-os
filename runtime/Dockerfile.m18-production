FROM python:3.12-slim
WORKDIR /app
COPY runtime /app/runtime
RUN pip install --no-cache-dir "psycopg[binary]==3.2.10"
RUN useradd --system --uid 10001 --create-home --home-dir /nonroot paiforge && chown -R paiforge:paiforge /app /nonroot
USER 10001
EXPOSE 8091
CMD ["python", "-m", "runtime.m18_production_gateway"]
